<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sfi.conflux</groupId>
    <artifactId>conflux-dependencies</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>conflux-dependencies</name>
    <description>Conflux 三方依赖版本 BOM（single source of truth）：全仓所有第三方构件
        版本在此单源管理，common / pay / invoice 三域以 import scope 引入、依赖声明一律不写
        version。收录标准：不管当前被几个域使用，只要是第三方 jar 就进 BOM——避免「单域使用
        时留域 pom、跨域后要搬家」的两段式维护。内部构件（conflux-common 及各域自产模块）
        版本不在此管理，仍留各自域 pom。根聚合器保持「不发布、不做 parent」的既有设计，
        BOM 以 import 方式提供版本而无需公共 parent。</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 基础设施类。注意 spring-boot-maven-plugin 不受 dependencyManagement 管理，
             pay/invoice 域 pom 中的 ${spring-boot.version} 插件版本需与本处同步升级。 -->
        <spring-boot.version>2.7.18</spring-boot.version>
        <okhttp.version>4.12.0</okhttp.version>
        <pdfbox.version>2.0.31</pdfbox.version>

        <!-- 渠道 SDK 类 -->
        <!-- wxjava 各模块版本必须一致（pay/mp/miniapp/cp/open 同属 4.x），统一单源管控 -->
        <weixin-java.version>4.7.2.B</weixin-java.version>
        <alipay-sdk.version>4.40.1067.ALL</alipay-sdk.version>
        <!-- 飞书官方 SDK（lark-oapi）：Maven Central 最新版本，JDK 8 兼容 -->
        <feishu-sdk.version>2.4.19</feishu-sdk.version>
        <!-- 百望云 BOPSDK：中央仓库不发布，需 install:install-file 到私服/本地仓库 -->
        <baiwang-bopsdk.version>3.4.871</baiwang-bopsdk.version>
        <!-- 诺诺开放平台 SDK：Maven Central 可获取，JDK 8 兼容 -->
        <nuonuo-sdk.version>1.0.6.1</nuonuo-sdk.version>
        <!-- sms4j 短信聚合 SDK：作为短信渠道底层 SDK 引入，版本单源管控 -->
        <sms4j.version>3.3.5</sms4j.version>
        <!-- x-file-storage 文件聚合 SDK：core 原始包（非 starter），版本单源管控 -->
        <x-file-storage.version>2.3.0</x-file-storage.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 官方 BOM：jackson/slf4j/assertj/junit 等全部经此管理 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 共享三方件：三个域共同使用、必须版本一致的构件 -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <!-- 渠道 SDK 类：wxjava 各模块版本单源管控，支付域与登录域共用同一版本 -->
            <dependency>
                <groupId>com.github.binarywang</groupId>
                <artifactId>weixin-java-pay</artifactId>
                <version>${weixin-java.version}</version>
            </dependency>
            <!-- wxjava 登录模块：公众号/开放平台扫码(mp)、小程序(miniapp)、企业微信(cp) -->
            <dependency>
                <groupId>com.github.binarywang</groupId>
                <artifactId>weixin-java-mp</artifactId>
                <version>${weixin-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.binarywang</groupId>
                <artifactId>weixin-java-miniapp</artifactId>
                <version>${weixin-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.binarywang</groupId>
                <artifactId>weixin-java-cp</artifactId>
                <version>${weixin-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alipay.sdk</groupId>
                <artifactId>alipay-sdk-java</artifactId>
                <version>${alipay-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.larksuite.oapi</groupId>
                <artifactId>oapi-sdk</artifactId>
                <version>${feishu-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baiwang.bop</groupId>
                <artifactId>baiwang-bopsdk</artifactId>
                <version>${baiwang-bopsdk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nuonuo</groupId>
                <artifactId>open-sdk</artifactId>
                <version>${nuonuo-sdk.version}</version>
            </dependency>
            <!-- sms4j 短信聚合原始包（非 starter）：core/provider 由 BOM 统一管理版本，
                 api/comm/hutool 经 core 传递引入 -->
            <dependency>
                <groupId>org.dromara.sms4j</groupId>
                <artifactId>sms4j-core</artifactId>
                <version>${sms4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dromara.sms4j</groupId>
                <artifactId>sms4j-provider</artifactId>
                <version>${sms4j.version}</version>
            </dependency>
            <!-- x-file-storage 文件聚合原始包（非 starter）：平台实现与 FileStorageService 构建全部由它提供 -->
            <dependency>
                <groupId>org.dromara.x-file-storage</groupId>
                <artifactId>x-file-storage-core</artifactId>
                <version>${x-file-storage.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
