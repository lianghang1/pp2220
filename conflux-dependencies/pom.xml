<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.lianghang1</groupId>
    <artifactId>conflux-dependencies</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>conflux-dependencies</name>
    <description>Conflux 三方依赖版本 BOM（single source of truth）：全仓所有第三方构件
        版本在此单源管理，common / pay / invoice 三域以 import scope 引入、依赖声明一律不写
        version。收录标准：不管当前被几个域使用，只要是第三方 jar 就进 BOM——避免「单域使用
        时留域 pom、跨域后要搬家」的两段式维护。内部构件（conflux-common 及各域自产模块）
        版本不在此管理，仍留各自域 pom。根聚合器保持「不发布、不做 parent」的既有设计，
        BOM 以 import 方式提供版本而无需公共 parent。</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 基础设施类。注意 spring-boot-maven-plugin 不受 dependencyManagement 管理，
             pay/invoice 域 pom 中的 ${spring-boot.version} 插件版本需与本处同步升级。 -->
        <spring-boot.version>2.7.18</spring-boot.version>
        <okhttp.version>4.12.0</okhttp.version>
        <guava.version>32.1.3-jre</guava.version>
        <pdfbox.version>2.0.31</pdfbox.version>

        <!-- 渠道 SDK 类（当前仅支付域使用） -->
        <weixin-java-pay.version>4.7.2.B</weixin-java-pay.version>
        <alipay-sdk.version>4.40.1067.ALL</alipay-sdk.version>
        <ttl.version>2.14.5</ttl.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 官方 BOM：jackson/slf4j/assertj/junit 等全部经此管理 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 共享三方件：三个域共同使用、必须版本一致的构件 -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <!-- 渠道 SDK 类：当前仅支付域使用，但属第三方 jar，版本同样单源管控 -->
            <dependency>
                <groupId>com.github.binarywang</groupId>
                <artifactId>weixin-java-pay</artifactId>
                <version>${weixin-java-pay.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alipay.sdk</groupId>
                <artifactId>alipay-sdk-java</artifactId>
                <version>${alipay-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>transmittable-thread-local</artifactId>
                <version>${ttl.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
