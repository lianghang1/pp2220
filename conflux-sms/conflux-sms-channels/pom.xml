<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lianghang1</groupId>
        <artifactId>conflux-sms</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>conflux-sms-channels</artifactId>
    <packaging>jar</packaging>
    <description>短信渠道实现集合：aliyun（薄门面复用 sms4j），按包隔离</description>

    <dependencies>
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>conflux-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>conflux-sms-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 薄门面依赖的渠道 SDK：sms4j 核心，版本由 BOM 单源管理 -->
        <dependency>
            <groupId>org.dromara.sms4j</groupId>
            <artifactId>sms4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.dromara.sms4j</groupId>
            <artifactId>sms4j-provider</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
