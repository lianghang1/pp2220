<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.lianghang1</groupId>
    <artifactId>conflux-pay</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>conflux-pay</name>
    <description>Conflux 支付能力域父 pom：独立版本号与技术栈（JDK 8 / Spring Boot 2.7.18）。
        仅作为 conflux-pay-* 四个子模块的 parent，版本与 invoice 域互不影响。</description>

    <modules>
        <module>conflux-pay-core</module>
        <module>conflux-pay-channels</module>
        <module>conflux-pay-spring-boot-starter</module>
        <module>conflux-pay-example</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>1.8</java.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>

        <!-- 共享三方件版本由 conflux-dependencies BOM 单源管理（见下方 import）。
             spring-boot.version 仅剩 spring-boot-maven-plugin 插件版本在用，
             不受 dependencyManagement 管理，升版需与 BOM 同步。 -->
        <spring-boot.version>2.7.18</spring-boot.version>
        <conflux-common.version>1.0.0</conflux-common.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 共享依赖版本 single source：spring-boot/okhttp/guava/pdfbox 全部经此 BOM -->
            <dependency>
                <groupId>io.github.lianghang1</groupId>
                <artifactId>conflux-dependencies</artifactId>
                <version>1.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 公共基座：固定版本，不随本域 ${project.version} 漂移 -->
            <dependency>
                <groupId>io.github.lianghang1</groupId>
                <artifactId>conflux-common</artifactId>
                <version>${conflux-common.version}</version>
            </dependency>

            <!-- 本域自产模块 -->
            <dependency>
                <groupId>io.github.lianghang1</groupId>
                <artifactId>conflux-pay-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.lianghang1</groupId>
                <artifactId>conflux-pay-channels</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.lianghang1</groupId>
                <artifactId>conflux-pay-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 渠道 SDK 类三方件（weixin/alipay/ttl）版本经 BOM 管理，此处不再重复 -->
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.10.1</version>
                    <configuration>
                        <source>1.8</source>
                        <target>1.8</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>2.22.2</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
