<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sfi.conflux</groupId>
        <artifactId>conflux-pay</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>conflux-pay-channels</artifactId>
    <packaging>jar</packaging>
    <name>conflux-pay-channels</name>
    <description>渠道实现集合：mock / wechat / alipay / unionpay / paypal，按包隔离；渠道专属 SDK 依赖 optional，缺依赖不影响其他渠道</description>

    <dependencies>
        <dependency>
            <groupId>com.sfi.conflux</groupId>
            <artifactId>conflux-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sfi.conflux</groupId>
            <artifactId>conflux-pay-core</artifactId>
        </dependency>
        <!-- 平台客户端层：支付宝 client 构造/缓存委托平台层薄门面；与 alipay-sdk 同为 optional，
             使用方引入支付宝渠道时按需一并引入，不破坏"渠道 SDK 按需激活"的既有语义 -->
        <dependency>
            <groupId>com.sfi.conflux</groupId>
            <artifactId>conflux-platform-alipay</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 渠道专属 SDK：optional，使用方按需引入对应坐标后该渠道才会激活 -->
        <dependency>
            <groupId>com.github.binarywang</groupId>
            <artifactId>weixin-java-pay</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.alipay.sdk</groupId>
            <artifactId>alipay-sdk-java</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
