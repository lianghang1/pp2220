<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.lianghang1</groupId>
        <artifactId>conflux-invoice</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>conflux-invoice-channels</artifactId>
    <packaging>jar</packaging>
    <name>conflux-invoice-channels</name>
    <description>数电票服务商渠道实现：mock / 百旺金穗云 / 百旺票税云 / 金蝶发票云 / 企享云，
        按包隔离；全部走 common OkHttp 传输层，不直接依赖任何厂商 SDK。</description>

    <dependencies>
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>conflux-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.lianghang1</groupId>
            <artifactId>conflux-invoice-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 百望云 BOPSDK：官方 SDK 自包含 com.baiwang.open.*，其 jackson/dom4j/bcprov
             等依赖在 SDK pom 中均标为 optional，需按运行实际需要在此显式补齐 -->
        <dependency>
            <groupId>com.baiwang.bop</groupId>
            <artifactId>baiwang-bopsdk</artifactId>
        </dependency>
        <!-- 诺诺开放平台 SDK：签名/报文组装/HTTP 均由官方 NNOpenSDK 封装，
             渠道侧只组装业务 JSON 并解析响应，不自行实现签名 -->
        <dependency>
            <groupId>com.nuonuo</groupId>
            <artifactId>open-sdk</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
